NODE_ENV=production
PORT=3000
BASE_URL=https://manual-pay.example.com
SUB2API_BASE_URL=https://sub2api.example.com
SUB2API_ADMIN_API_KEY=replace-with-admin-api-key
SESSION_SECRET=replace-with-at-least-32-random-characters
SESSION_TTL_HOURS=24
ADMIN_USERNAME=replace-with-admin-username
ADMIN_PASSWORD_HASH=replace-with-bcrypt-password-hash
DATABASE_PATH=/app/data/manual-pay.sqlite
ALIPAY_QR_IMAGE=/app/data/alipay-qr.png
RECHARGE_AMOUNTS=10,20,50
BALANCE_PER_CNY=1
ORDER_EXPIRE_HOURS=24
PROCESSING_STALE_MINUTES=15
TRUST_PROXY_HOPS=1
USER_AUTH_RATE_LIMIT_WINDOW_MS=900000
USER_AUTH_RATE_LIMIT_MAX=10
ORDER_CREATE_RATE_LIMIT_WINDOW_MS=60000
ORDER_CREATE_RATE_LIMIT_MAX=10
ORDER_SUBMIT_RATE_LIMIT_WINDOW_MS=60000
ORDER_SUBMIT_RATE_LIMIT_MAX=10
ADMIN_LOGIN_RATE_LIMIT_WINDOW_MS=900000
ADMIN_LOGIN_RATE_LIMIT_MAX=5
