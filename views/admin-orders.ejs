<!doctype html>
<html lang="zh-CN"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><meta name="csrf-token" content="<%= csrfToken %>"><title><%= title %> | Sub2API</title><link rel="stylesheet" href="/assets/app.css"></head>
<body><header class="site-header"><div class="shell header-inner"><strong>Sub2API 人工充值审核</strong><button class="quiet" id="logout" type="button">退出</button></div></header><main class="shell page-main"><div class="toolbar"><input id="search" placeholder="订单号、用户、邮箱或交易号"><select id="status"><option value="pending_review,recharge_failed">待处理</option><option value="pending_review">待审核</option><option value="recharge_failed">充值失败</option><option value="approved">已充值</option><option value="rejected">已拒绝</option></select></div><p id="page-feedback" role="status"></p><div class="table-wrap"><table><thead><tr><th>订单</th><th>用户</th><th>金额</th><th>交易号</th><th>状态</th><th>操作</th></tr></thead><tbody id="orders"></tbody></table></div></main><dialog id="approve-dialog"><form method="dialog"><p id="approve-copy"></p><menu><button value="cancel">取消</button><button id="approve-confirm" value="default">确认到账并充值</button></menu></form></dialog><script type="module" src="/assets/admin.js"></script></body></html>
